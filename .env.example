# Copy this file to .env (or set these as Function app settings) and fill in values.

# --- Model provider (Azure OpenAI) ---
# Endpoint of your Azure OpenAI / AI Services account.
AZURE_OPENAI_ENDPOINT="https://<your-ai-services>.openai.azure.com/"
# Deployment (model) name to use.
AZURE_OPENAI_DEPLOYMENT_NAME="chat"
# Optional: set an API key to use key auth instead of managed identity for the model.
AZURE_OPENAI_API_KEY=""

# --- Entra-protected SQL MCP server ---
# URL of the SQL MCP server (e.g. a Logic Apps connector gateway). The Function
# authenticates to it with its managed identity (DefaultAzureCredential). Leave
# unset to run the agent without the SQL MCP server attached.
SQL_MCP_SERVER_URL=""
