{
  "name": "functions-agent-sql-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Bundles a pinned Copilot CLI so the Python app drives a matched SDK/CLI pair.",
  "scripts": {
    "install:linux": "npm install --no-save @github/copilot-linux-x64@1.0.13",
    "install:macos": "npm install --no-save @github/copilot-darwin-arm64@1.0.13",
    "install:local": "npm install"
  },
  "dependencies": {
    "@github/copilot": "1.0.13"
  },
  "optionalDependencies": {
    "@github/copilot-darwin-arm64": "1.0.13",
    "@github/copilot-linux-x64": "1.0.13"
  }
}
